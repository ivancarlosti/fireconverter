# FireConverter — copy to docker/.env and adjust if needed.
# The compose file reads these; none is required.

# Port published on the host. The container always listens on 3000.
APP_PORT=3069

# Log verbosity: debug, info, warn, error.
LOG_LEVEL=info

# Server-side video limits. Images and audio never reach the server.
MAX_UPLOAD_MB=2048
MAX_DURATION_SECONDS=21600
JOB_TTL_MINUTES=60
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_IP=4
TARGET_SIZE_MAX_MB=4096

# Only enable behind a reverse proxy that overwrites X-Forwarded-For.
APP_TRUST_PROXY=false
